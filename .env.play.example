# Play Publish Kit — per-app config. Copy to `.env.play` (gitignored) and fill in.
# Scripts look for this file in order: $ENV_PLAY_PATH (explicit) > next to the
# kit (copy-in usage) > the current working directory (kit installed elsewhere,
# e.g. as a Claude Code plugin — keep .env.play in your project root then).

# ── App identity ──────────────────────────────────────────────────────────────
APP_PACKAGE="com.example.app"        # applicationId / Play package name
APP_NAME="Example App"               # used in keystore dname + messages

# Flutter build flavor. Leave empty if the app has no flavors.
FLAVOR=""                            # e.g. "prod"

# Path to the Flutter project root (the dir with pubspec.yaml).
# Defaults to the current working directory when publish.sh runs.
PROJECT_DIR=""

# Override the AAB path publish.sh uploads. Leave empty to auto-resolve from
# PROJECT_DIR (+ FLAVOR). Set only for non-standard build output locations.
AAB_PATH=""

# ── Upload signing ────────────────────────────────────────────────────────────
# Play App Signing holds the real app key; this is your *upload* key.
KEYSTORE_PATH="$HOME/.config/play/upload.jks"
KEYSTORE_PASSWORD=""
KEY_ALIAS="upload"
KEY_PASSWORD=""

# ── Play Developer API ────────────────────────────────────────────────────────
# Play Console → Setup → API access → service account JSON with
# "Release to testing tracks" + "Manage production releases".
PLAY_SERVICE_ACCOUNT_JSON="$HOME/.config/play/service-account.json"

# ── Store listing metadata (optional) ─────────────────────────────────────────
# Directory with the fastlane store listing (the dir containing en-US/...).
# Default: the kit's own fastlane/metadata/android. Uncomment when the listing
# lives in your project. Can also be passed as an env var to publish.sh —
# leave it commented here in that case, or the file value wins.
#METADATA_DIR="$PROJECT_DIR/fastlane/metadata/android"

# ── Build-time config baked into the AAB (optional) ───────────────────────────
# Space-separated key=value pairs, each passed as --dart-define.
# Example: DART_DEFINES="API_BASE_URL=https://api.example.com FLAG=true"
DART_DEFINES=""
